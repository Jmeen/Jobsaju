# Browser-visible PortOne V2 identifiers. Do not put PORTONE_API_SECRET here.
VITE_PORTONE_STORE_ID=store-your-portone-store-id
VITE_PORTONE_CHANNEL_KEY=channel-key-your-kcp-test-channel

# Server-only secret: register this in Cloudflare Pages, never in a Vite env file.
# PORTONE_API_SECRET=your-portone-v2-api-secret

# PostHog project token (public ingestion key, NOT a personal API key).
# Use the host shown in your project's setup: US or EU. Both fields are required.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# Local capture is OFF by default. Use a separate test project when enabling.
VITE_POSTHOG_DEBUG=false

# Cloudflare Pages runtime variables, same project/host as the browser.
# POSTHOG_KEY=
# POSTHOG_HOST=
