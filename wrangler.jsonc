{
	"name": "job-saju",
	"compatibility_date": "2026-08-13",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"pages_build_output_dir": "./dist",
	"vars": {
		"GEMINI_MODEL": "gemini-2.5-flash",
		"GEMINI_TRANSPORT": "vertex",
		"VERTEX_PROJECT_ID": "gen-lang-client-0289229182",
		"VERTEX_LOCATION": "global"
	},
	"r2_buckets": [
		{
			"binding": "SHARE_CARDS",
			"bucket_name": "job-saju-share-cards"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SAJU_KV",
			"id": "7c0710b502cc4c06aac1ed9e5b16a9a1"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "paid_reports_db",
			"database_id": "f01b8131-035f-430e-be12-4d8be52c98b2"
		}
	]

}
