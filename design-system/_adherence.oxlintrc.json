{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/guardian/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:BM DOHYEON|Nanum Gothic))/i]",
        "message": "Font not provided by the design system. Available: BM DOHYEON, Nanum Gothic."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|brand)$/]",
        "message": "<Badge> tone must be one of 'muted' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|element|disabled|onClick|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, element, disabled, onClick, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|guardian)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'guardian'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='element'] > Literal[value!=/^(?:wood|fire|earth|metal|water)$/]",
        "message": "<Button> element must be one of 'wood' | 'fire' | 'earth' | 'metal' | 'water'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:card|strong|brand-soft)$/]",
        "message": "<Card> tone must be one of 'card' | 'strong' | 'brand-soft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChemistryBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:guardian|assetBase|isSharing|onShare|onView|key|ref|className|style|children)$/]",
        "message": "<ChemistryBlock> doesn't accept that prop. Declared props: guardian, assetBase, isSharing, onShare, onView."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChemistryScore'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|score|key|ref|className|style|children)$/]",
        "message": "<ChemistryScore> doesn't accept that prop. Declared props: label, score."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChemistryShareCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:a|b|score|relation|size|aspect|key|ref|className|style|children)$/]",
        "message": "<ChemistryShareCard> doesn't accept that prop. Declared props: a, b, score, relation, size, aspect."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChemistryShareCard'] > JSXAttribute[name.name='aspect'] > Literal[value!=/^(?:square|story)$/]",
        "message": "<ChemistryShareCard> aspect must be one of 'square' | 'story'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CollectionBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:sequence|total|element|key|ref|className|style|children)$/]",
        "message": "<CollectionBadge> doesn't accept that prop. Declared props: sequence, total, element."
      },
      {
        "selector": "JSXOpeningElement[name.name='CollectionBadge'] > JSXAttribute[name.name='element'] > Literal[value!=/^(?:wood|fire|earth|metal|water)$/]",
        "message": "<CollectionBadge> element must be one of 'wood' | 'fire' | 'earth' | 'metal' | 'water'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Guardian'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|sequence|imageUrl|nickname|copy|ganzhiKo|animal|animalEmoji|element|elementLabel|key|ref|className|style|children)$/]",
        "message": "<Guardian> doesn't accept that prop. Declared props: id, sequence, imageUrl, nickname, copy, ganzhiKo, animal, animalEmoji, element, elementLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|value|locked|key|ref|className|style|children)$/]",
        "message": "<ScoreItem> doesn't accept that prop. Declared props: icon, label, value, locked."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShareCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:guardian|size|key|ref|className|style|children)$/]",
        "message": "<ShareCard> doesn't accept that prop. Declared props: guardian, size."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Badge": {
        "replaces": []
